<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">
        <TextView
            android:id="@+id/textIngredientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Potatoes"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/buttonEdit"
            app:layout_constrainStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textQuantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2 pieces"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/buttonEdit"
            app:layout_constrainStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textIngredientName" />

        <TextView
            android:id="@+id/textExpiry"
            android:layout_width="72dp"
            android:layout_height="15dp"
            android:text="Expires: 2026-09-01"
            android:textSize="13sp"
            app:layout_constrainStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonEdit"
            app:layout_constraintTop_toBottomOf="@id/textQuantity" />

        <ImageButton
            android:id="@+id/buttonEdit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit Ingredients"
            android:src="@android:drawable/ic_menu_edit"
            app:layout_constraintTop_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonDelete" />
        <ImageButton
            android:id="@+id/buttonDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Ingredients"
            android:src="@android:drawable/ic_menu_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>